{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path'),s=require('node:child_process');const d=process.env.CODEX_PROJECT_ROOT;if(!d||!p.isAbsolute(d))process.exit(2);const r=s.spawnSync(process.execPath,[p.join(d,'.claude/hooks/hook-runner.mjs'),...process.argv.slice(1)],{stdio:'inherit',timeout:28000});process.exit(r.status===0&&!r.error&&!r.signal?0:2)\" session-start codex || exit 2",
            "timeout": 30,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path'),s=require('node:child_process');const d=process.env.CODEX_PROJECT_ROOT;if(!d||!p.isAbsolute(d))process.exit(2);const r=s.spawnSync(process.execPath,[p.join(d,'.claude/hooks/hook-runner.mjs'),...process.argv.slice(1)],{stdio:'inherit',timeout:28000});process.exit(r.status===0&&!r.error&&!r.signal?0:2)\" pre-tool-use codex || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
