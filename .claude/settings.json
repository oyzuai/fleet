{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/load-context.sh\""
          }
        ]
      }
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "oyzu-context": {
      "source": {
        "source": "github",
        "repo": "oyzuai/context"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "context@oyzu-context": true,
    "ponytail@oyzu-context": true,
    "pstack@oyzu-context": true,
    "thermonuclear@oyzu-context": true
  }
}
