{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyzu.dev/contracts/kinds-v1alpha1/result.schema.json",
  "title": "Draft deployment kind protocol v1alpha1: operation result",
  "description": "The one JSON document a kind writes on standard output. It decides the outcome; the exit code does not. A verify that ran its suite succeeds whether the tests passed or not; verification.passed carries the verdict, and failed means the suite could not be run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "operation", "execution_id", "outcome"],
  "properties": {
    "schema_version": { "const": "v1alpha1" },
    "type": { "const": "deployment-kind-result" },
    "operation": { "$ref": "common.schema.json#/$defs/operation" },
    "execution_id": { "$ref": "common.schema.json#/$defs/executionId" },
    "outcome": {
      "description": "stale-plan: apply refused because the approved plan no longer holds. Nothing changed; the engine plans again.",
      "enum": ["succeeded", "failed", "stale-plan"]
    },
    "plan": { "$ref": "plan.schema.json" },
    "applied": {
      "description": "apply and rollback: the component versions the kind claims are now in place. observe must report the same.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "common.schema.json#/$defs/componentVersion" }
    },
    "observed": {
      "description": "observe and watch: the observation envelope; for watch, the last state it saw.",
      "$ref": "common.schema.json#/$defs/observedState"
    },
    "outputs": {
      "description": "apply, rollback and observe: the values each component publishes for other components to bind, by component and then output name, as they stand after the operation. A sensitive output carries no value.",
      "type": "object",
      "maxProperties": 256,
      "propertyNames": { "$ref": "common.schema.json#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "maxProperties": 1024,
        "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$" },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sensitive"],
          "properties": {
            "value": { "description": "The output's value, any JSON. Absent when sensitive." },
            "sensitive": { "type": "boolean" }
          },
          "if": { "properties": { "sensitive": { "const": true } } },
          "then": { "not": { "required": ["value"] } },
          "else": { "required": ["value"] }
        }
      }
    },
    "staged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address"],
      "properties": {
        "address": {
          "description": "A private address that reaches the staged version before it takes traffic.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "verification": { "$ref": "common.schema.json#/$defs/verificationReport" },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drifted", "changes"],
      "properties": {
        "drifted": { "type": "boolean" },
        "changes": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "common.schema.json#/$defs/change" }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "code", "message"],
      "properties": {
        "class": {
          "description": "retryable: nothing changed. needs-person: a person must act, for example a denied permission or a quota. partial-change: the target may be between versions, so the release run holds.",
          "enum": ["retryable", "needs-person", "partial-change"]
        },
        "code": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "problems": {
          "description": "validate: each setting or input that failed, by JSON pointer.",
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string", "maxLength": 1024 },
              "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "failed" } } },
      "then": { "required": ["failure"] },
      "else": { "not": { "required": ["failure"] } }
    },
    {
      "if": { "properties": { "outcome": { "const": "stale-plan" } } },
      "then": { "properties": { "operation": { "const": "apply" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "succeeded" } } },
      "then": {
        "allOf": [
          { "if": { "properties": { "operation": { "const": "plan" } } }, "then": { "required": ["plan"] }, "else": { "not": { "required": ["plan"] } } },
          { "if": { "properties": { "operation": { "enum": ["apply", "rollback"] } } }, "then": { "required": ["applied"] }, "else": { "not": { "required": ["applied"] } } },
          { "if": { "properties": { "operation": { "enum": ["observe", "watch"] } } }, "then": { "required": ["observed"] }, "else": { "not": { "required": ["observed"] } } },
          { "if": { "properties": { "operation": { "const": "stage" } } }, "then": { "required": ["staged"] }, "else": { "not": { "required": ["staged"] } } },
          { "if": { "properties": { "operation": { "const": "drift" } } }, "then": { "required": ["drift"] }, "else": { "not": { "required": ["drift"] } } },
          { "if": { "properties": { "operation": { "const": "verify" } } }, "then": { "required": ["verification"] }, "else": { "not": { "required": ["verification"] } } },
          { "if": { "properties": { "operation": { "enum": ["apply", "rollback", "observe"] } } }, "else": { "not": { "required": ["outputs"] } } }
        ]
      },
      "else": {
        "not": { "anyOf": [{ "required": ["plan"] }, { "required": ["applied"] }, { "required": ["observed"] }, { "required": ["staged"] }, { "required": ["drift"] }, { "required": ["outputs"] }, { "required": ["verification"] }] }
      }
    }
  ]
}
